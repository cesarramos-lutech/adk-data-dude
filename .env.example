# Copy to .env and fill your values (or copy from data-science-agent .env for look_ecommerce).
# Never commit .env.

## Model backend: 1 = Vertex
GOOGLE_GENAI_USE_VERTEXAI=1

## Vertex / GCP (required)
GOOGLE_CLOUD_PROJECT=YOUR_VALUE_HERE
GOOGLE_CLOUD_LOCATION=YOUR_VALUE_HERE

## BigQuery (same as data-science-agent for look_ecommerce)
BQ_COMPUTE_PROJECT_ID=YOUR_VALUE_HERE
BQ_DATA_PROJECT_ID=YOUR_VALUE_HERE
BQ_DATASET_ID=YOUR_VALUE_HERE

## Dataset config (path to look_ecommerce_dataset_config.json)
DATASET_CONFIG_FILE=./look_ecommerce_dataset_config.json

## Model — single var used by agent, NL2SQL, and recommendations.
## To use different models per tool, introduce NL2SQL_MODEL / RECOMMENDATIONS_MODEL later.
ROOT_AGENT_MODEL=gemini-2.5-pro
